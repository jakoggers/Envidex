# Server-side only — never commit real secrets.

# eBay Browse API (Buy) — OAuth client credentials
# Create an app: https://developer.ebay.com/my/keys
# Enable Browse API access. Production may require additional eBay approval.
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=

# sandbox | production (default: production)
EBAY_ENV=production

# Marketplace id header for Browse API (default EBAY_US)
EBAY_MARKETPLACE_ID=EBAY_US

# Per-provider timeout in milliseconds (default 12000)
PROVIDER_TIMEOUT_MS=12000
