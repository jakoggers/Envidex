# MongoDB (required for auth and private observations)
# Note: the Next.js app uses MONGODB_URI_REAL. The optional Python
# animal-info path may use MONGO_URI if Gemini logging is enabled.
MONGODB_URI_REAL=mongodb://127.0.0.1:27017/envidex

# NextAuth (required)
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=

# Local Keras prediction service (default inference path)
PREDICTION_API_BASE_URL=http://127.0.0.1:8000
# Optional override for model artifact paths used by Python
# MODEL_PATH=
# CLASS_NAMES_PATH=
MODEL_VERSION=animal_species_model.keras

# Private local image store (filesystem). Do not point this at a public web root.
STORAGE_BACKEND=local
STORAGE_ROOT=./data/private-media
MAX_UPLOAD_BYTES=5242880
MAX_IMAGE_PIXELS=4096

# Optional — Anthropic identify (explicit opt-in in UI only; never silent fallback)
ANTHROPIC_API_KEY=

# Optional — legacy public Blob (not used for new private saves in this pass)
BLOB_READ_WRITE_TOKEN=

# Optional — OAuth providers
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Optional — Gemini animal-info enrichment on the Python service (not required to start /predict)
GEMINI_API_KEY=
# MONGO_URI=mongodb://127.0.0.1:27017/
